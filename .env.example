# Copy to .env.local for development, and set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used to build payment return URLs. Must be the public origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://leadpathinitiative.org

# ---------------------------------------------------------------------------
# Email — contact, partnership and get-involved form delivery (Resend)
# ---------------------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=website@leadpathinitiative.org
# Where enquiries land.
CONTACT_TO_EMAIL=info@leadpathinitiative.org
# Optional — donation alerts go here instead of CONTACT_TO_EMAIL if set.
DONATIONS_TO_EMAIL=

# ---------------------------------------------------------------------------
# Flutterwave — mobile money (MTN, Airtel) and cards, in UGX or USD
# ---------------------------------------------------------------------------
# https://app.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=

# ---------------------------------------------------------------------------
# PayPal — international cards and PayPal balances, USD only
# ---------------------------------------------------------------------------
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" uses api-m.paypal.com; anything else stays on sandbox.
PAYPAL_ENV=sandbox
# Required only for monthly PayPal donations. Create a billing plan in PayPal;
# the donor's chosen amount overrides the plan price at subscription time, so
# one plan covers every amount. Leave blank and monthly PayPal is disabled
# (donors are pointed at Flutterwave instead).
PAYPAL_MONTHLY_PLAN_ID=
